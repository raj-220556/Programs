/* Reverse a given number */

declare
	num number := &num;
	rev number := 0;
	n1 number;
begin
	n1 := num;
	while (n1 <> 0) loop
		rev := rev *10 + mod(n1,10);
		n1 := trunc(n1/10);
	end loop;
	dbms_output.put_line(num || ' reverse is ' || rev);
end;
/



/* Sum of factors of given number */

declare
	num number := &num;
	s number := 0;
	n1 number;
begin
	n1 := num;
	for i in 1..num loop
		if (mod(n1,i) = 0) then
			s := s + i;
		end if;
	end loop;
	dbms_output.put_line(num || ' factors sum : ' || s);
end;
/



       

